node_modules/
dist/
.env
.env.*
!.env.example
*.log
.DS_Store
serviceAccount*.json
__pycache__/
.venv/
pmt-env/
analysis/.ipynb_checkpoints/
server/data/analysis/*.checkpoint.ndjson
# Local researcher files — may contain a personal pmtr_ token
temp.py
starter.py
.superpowers/

# Migration backups — curated research rows dumped before a schema rewrite
as-degree-backup-*.json

# Claude Code worktrees — isolated checkouts, never part of the repo
.claude/worktrees/

# Parked Maryland crawl cache (regenerable; see deprecated/maryland/)
deprecated/maryland/cache/

# Virginia guide + course crawl cache (regenerable)
server/.virginia-cache/
# Degree-page captures are regenerable, but the compact CS scope ledger is a
# checked-in source artifact for the Virginia prerequisite builder.
server/.va-degrees/*
!server/.va-degrees/cs_course_scope.json
server/.virginia-courses/
server/.va-prerequisites-cache/

# Captured catalog pages and the Chrome profile that fetches them. Regenerable
# by `node scripts/captureVirginiaCatalogs.js`; the reviewable output of the
# scrape is .va-catalogs/requirements/, which IS committed.
server/.va-catalogs/pages/
server/.va-catalogs/.browser-profile/

# VCCS per-college course-catalogue captures. Regenerable by
# `node scripts/captureVccsCourseCatalogs.js`; the reviewable output is
# .va-courses/catalog/<slug>.json and .va-courses/index.json, which ARE
# committed — they are the course-supply evidence the guide join reads.
server/.va-courses/pages/

# Transfer Guide captures. Regenerable by
# `node scripts/captureVirginiaTransferGuides.js`; the reviewable output is
# .va-guides/guides.json, which IS committed.
server/.va-guides/pages/

# Pre-rebuild snapshots of replaced Virginia collections. Regenerable only in
# the sense that they preserve data a rebuild discarded — kept out of git for
# size (43 MB), not because they are disposable.
server/.va-backups/

# UC catalogue captures. Regenerable by scripts/captureUcCatalogs.js,
# captureCoursedogCatalogs.js, captureAcalogCatalogs.js and
# captureUcMajorRequirements.js; the reviewable outputs are the small index
# files, which ARE committed so a reader can see what was fetched and from where.
server/.uc-catalogs/pages/
server/.uc-catalogs/coursedog/
server/.uc-catalogs/acalog/
server/.uc-catalogs/pdf/
server/.uc-catalogs/majors/*.html
server/.uc-catalogs/.browser-profile/
