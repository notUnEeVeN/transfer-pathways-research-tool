{
  "name": "pmt-research-server",
  "version": "0.1.0",
  "private": true,
  "description": "Research console API: read routes over the curated research dataset + the audit stack",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:local": "MONGO_URI=mongodb://localhost:27017 DB_NAME=pmt_research nodemon server.js",
    "schema:audit": "node scripts/migrateCanonicalSchema.js",
    "schema:apply": "node scripts/migrateCanonicalSchema.js --apply",
    "schema:cleanup": "node scripts/migrateCanonicalSchema.js --apply --drop-legacy --yes",
    "slots:audit": "node scripts/migrateAsDegreeSlots.js",
    "slots:apply": "node scripts/migrateAsDegreeSlots.js --apply",
    "snapshot:multi-campus": "node scripts/generateMultiCampusPathwaysSnapshot.js",
    "va:catalog:plan": "DOTENV_CONFIG_PATH=.env node -r dotenv/config scripts/importVirginiaCatalogDegrees.js --accepted-compositions-only --source-plan --dry-run",
    "va:prerequisites:vccs-scope:check": "node scripts/va/buildCanonicalVccsCourseScope.js",
    "va:prerequisites:vccs-corpus:check": "node scripts/buildVirginiaPrerequisites.js --check",
    "va:prerequisites:vccs-publication:check": "node scripts/va/buildVccsFigure6PrerequisiteCorpus.js",
    "va:prerequisites:vccs-publication:write": "node scripts/va/buildVccsFigure6PrerequisiteCorpus.js --write",
    "va:prerequisites:vccs-scope:write": "node scripts/va/buildCanonicalVccsCourseScope.js --write",
    "va:prerequisites:southwest-evidence:check": "node services/virginia/southwestVccsPrerequisiteEvidence.js",
    "va:prerequisites:laurel-ridge-evidence:check": "node services/virginia/laurelRidgeVccsPrerequisiteEvidence.js",
    "va:projection:plan": "node scripts/va/buildVaDocuments.js",
    "va:publication:audit": "node scripts/va/auditPublicationReadiness.js --source-plan",
    "va:publication:audit:stored": "node scripts/va/auditPublicationReadiness.js",
    "va:release:check": "node scripts/va/checkRelease.js",
    "va:rollback:contracts:check": "node scripts/va/auditRollbackReadiness.js",
    "va:rollback:live:audit": "node scripts/va/auditLiveRollbackInventory.js",
    "va:verification:review": "node scripts/va/reviewPublicationVerifications.js",
    "va:prerequisites:vccs-gaps:check": "node scripts/va/buildVccsPrerequisiteGapEvidence.js",
    "va:prerequisites:university-scope:check": "node scripts/va/buildUniversityPrerequisiteScope.js",
    "va:prerequisites:remaining-university-closure-evidence:check": "node scripts/va/buildRemainingUniversityPrerequisiteClosureEvidence.js",
    "va:prerequisites:vcu-egmn-outside-scope-evidence:check": "node scripts/va/buildVcuEgmnOutsideScopePrerequisiteEvidence.js",
    "va:prerequisites:radford-uva-wise-recursive-evidence:check": "node scripts/va/buildRadfordUvaWiseRecursivePrerequisiteEvidence.js",
    "va:prerequisites:university-acquisition:check": "node scripts/va/acquireUniversityPrerequisites.js",
    "va:prerequisites:university-candidates:check": "node scripts/va/buildUniversityPrerequisiteCandidates.js",
    "va:prerequisites:university-review:check": "node scripts/va/buildUniversityPrerequisiteReview.js",
    "va:prerequisites:cnu-cpen371w-evidence:check": "node scripts/va/captureCnuCpen371wPrerequisiteEvidence.js",
    "va:prerequisites:vsu-arabic-evidence:check": "node scripts/va/captureVirginiaStateArabicPrerequisiteEvidence.js",
    "va:prerequisites:shenandoah-discovery:check": "node scripts/va/captureShenandoahAcalogDiscovery.js",
    "va:source-gaps:figure34:check": "node scripts/va/auditFigure34SourceBlockers.js",
    "va:evidence:longwood-civitae:check": "node scripts/va/captureLongwoodCivitaeFigureEvidence.js",
    "va:evidence:randolph-macon-collegiate-capture:check": "node scripts/va/captureRandolphMaconCollegiateAttributeSources.js",
    "va:evidence:randolph-macon-collegiate:check": "node scripts/va/buildRandolphMaconCollegiateAttributeEvidence.js",
    "va:evidence:radford-transfer-degree:check": "node scripts/va/captureRadfordTransferDegreeEvidence.js",
    "va:evidence:radford-science-pair:check": "node scripts/va/captureRadfordSciencePairEvidence.js",
    "va:evidence:radford-college-science-pair:check": "node scripts/va/captureRadfordCollegeSciencePairEvidence.js",
    "va:evidence:radford-college-science-pair:refresh": "node scripts/va/captureRadfordCollegeSciencePairEvidence.js --refresh",
    "va:evidence:vcu-transfer-policy:check": "node scripts/va/captureVcuTransferPolicyEvidence.js",
    "va:evidence:vmi-open-rule-capture:check": "node scripts/va/captureVirginiaMilitaryInstituteOpenRuleSources.js",
    "va:evidence:vmi-open-rules:check": "node scripts/va/buildVirginiaMilitaryInstituteOpenRuleEvidence.js",
    "va:evidence:virginia-tech-pathways:check": "node scripts/va/captureVirginiaTechPathwaysCapacity.js",
    "va:evidence:virginia-tech-equivalency-quantity:check": "node scripts/va/captureVirginiaTechEquivalencyQuantityEvidence.js",
    "va:evidence:virginia-tech-csc222-java:check": "node scripts/va/captureVirginiaTechCsc222JavaEvidence.js",
    "va:evidence:virginia-tech-graduate-cs-prerequisites:check": "node scripts/va/captureVirginiaTechGraduateCsPrerequisiteEvidence.js",
    "va:evidence:virginia-tech-transfer-policy:check": "node scripts/va/captureVirginiaTechTransferPolicyEvidence.js",
    "va:evidence:virginia-state-figure1-gap:check": "node scripts/va/buildVirginiaStateFigure1SourceGapEvidence.js",
    "va:evidence:william-mary:check": "node scripts/va/buildWilliamMaryCurrentCatalogFigureEvidence.js",
    "va:prerequisites:publication:plan": "node scripts/va/publishFigure6Prerequisites.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.5.0",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "playwright": "^1.62.1",
    "vitest": "^2.0.5"
  }
}
